<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ephemeris.UI.Avalonia.Views.LauncherWindow"
        Title="Ephemeris"
        Width="360" Height="210"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*,*" Margin="24,16,24,16">

        <TextBlock Grid.Row="0"
                   Text="Ephemeris — Astronomical Calculator"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontWeight="Bold"
                   FontSize="13"
                   Margin="0,0,0,12" />

        <Button Grid.Row="1"
                x:Name="SkyViewBtn"
                Content="🌌  3D Sky View  (OpenGL)"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Margin="0,4" />

        <Button Grid.Row="2"
                x:Name="PlotBtn"
                Content="📈  Altitude Chart  (ScottPlot)"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Margin="0,4" />

    </Grid>

</Window>
