<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Ephemeris.UI.Avalonia.Controls"
        x:Class="Ephemeris.UI.Avalonia.Views.ScripturalEventLibraryWindow"
        Classes="Research"
        Title="Ephemeris — Scriptural Event Library"
        Width="720" Height="540"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto"
          Background="{DynamicResource ResearchBackgroundBrush}">

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource ResearchSurfaceBrush}"
                BorderBrush="{DynamicResource ResearchBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <StackPanel>
                <TextBlock Text="📖  Scriptural Event Library"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource ResearchTextPrimaryBrush}" />
                <TextBlock Text="Select a Biblical event to load its celestial configuration"
                           FontSize="12"
                           Foreground="{DynamicResource ResearchTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Content: list or empty state -->
        <Panel Grid.Row="1">

            <!-- Empty state shown when BuiltInScenarios.All is empty -->
            <controls:EmptyStateControl x:Name="EventsEmptyState"
                                        Icon="📖"
                                        Title="No Events"
                                        Subtitle="No scriptural events are configured"
                                        IsVisible="False" />

            <ListBox x:Name="EventsList"
                     Background="{DynamicResource ResearchBackgroundBrush}"
                     Margin="12" />

        </Panel>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="16,8">
            <Button x:Name="CancelBtn"
                    Classes="ResearchSecondary"
                    Content="Cancel" />
            <Button x:Name="OpenBtn"
                    Classes="Research"
                    Content="Open Event"
                    IsEnabled="False" />
        </StackPanel>

    </Grid>

</Window>
