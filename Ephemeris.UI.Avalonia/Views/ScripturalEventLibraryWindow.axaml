<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Ephemeris.UI.Models;assembly=Ephemeris.UI.Shared"
        x:Class="Ephemeris.UI.Avalonia.Views.ScripturalEventLibraryWindow"
        Title="Scriptural Event Library"
        Width="500" Height="400"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="16">

        <!-- Title -->
        <TextBlock DockPanel.Dock="Top"
                   Text="SCRIPTURAL EVENT LIBRARY"
                   FontWeight="Bold"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8" />

        <Separator DockPanel.Dock="Top" Margin="0,0,0,8" />

        <!-- Close button -->
        <Button DockPanel.Dock="Bottom"
                x:Name="CloseBtn"
                Content="Close"
                HorizontalAlignment="Center"
                Width="100"
                Margin="0,8,0,0" />

        <!-- Scrollable scenario list -->
        <ScrollViewer>
            <ItemsControl x:Name="ScenarioList" Margin="0,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:ScenarioModel">
                        <Border BorderBrush="Gray"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12,8"
                                Margin="0,4">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto">

                                <!-- Name (bold) -->
                                <TextBlock Grid.Row="0"
                                           Text="{Binding Name}"
                                           FontWeight="Bold"
                                           FontSize="13" />

                                <!-- Scripture reference (italic) -->
                                <TextBlock Grid.Row="1"
                                           Text="{Binding ScriptureReference}"
                                           FontStyle="Italic"
                                           Opacity="0.8"
                                           Margin="0,2,0,0" />

                                <!-- Description -->
                                <TextBlock Grid.Row="2"
                                           Text="{Binding Description}"
                                           Margin="0,2,0,0" />

                                <!-- Location + Load button -->
                                <Grid Grid.Row="3"
                                      ColumnDefinitions="*,Auto"
                                      Margin="0,4,0,0">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding LocationName}"
                                               Opacity="0.7"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="Load Event"
                                            Tag="{Binding}"
                                            Click="OnLoadEventClick" />
                                </Grid>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</Window>
