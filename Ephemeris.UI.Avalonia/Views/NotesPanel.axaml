<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ephemeris.UI.Avalonia.Views.NotesPanel"
        Title="Research Notes"
        Width="480" Height="520"
        MinWidth="360" MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="16">

        <!-- Header: NOTES — [Session Name] -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,0,0,4">
            <TextBlock Text="NOTES —"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
            <TextBox x:Name="SessionNameBox"
                     Watermark="Session name…"
                     Width="220"
                     VerticalAlignment="Center" />
        </StackPanel>

        <Separator DockPanel.Dock="Top" Margin="0,0,0,8" />

        <!-- Bottom action bar -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Left"
                    Margin="0,8,0,0">
            <Button x:Name="SaveSessionBtn"
                    Content="💾 Save Session" />
            <Button x:Name="ExportNotesBtn"
                    Content="📤 Export Notes" />
        </StackPanel>

        <!-- Time marker row -->
        <Grid DockPanel.Dock="Bottom"
              ColumnDefinitions="Auto,*"
              Margin="0,6,0,0">
            <Button Grid.Column="0"
                    x:Name="SaveMarkerBtn"
                    Content="📌 Save Time Marker" />
            <TextBlock Grid.Column="1"
                       x:Name="MarkerTimestampLabel"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"
                       Opacity="0.7" />
        </Grid>

        <!-- Notes text area (fills remaining space) -->
        <TextBox x:Name="NotesBox"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinLines="6"
                 VerticalAlignment="Stretch"
                 VerticalContentAlignment="Top"
                 Watermark="Enter research notes here…" />

    </DockPanel>

</Window>
